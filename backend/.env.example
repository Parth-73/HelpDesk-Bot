APP_ENV=development
DATABASE_URL=
# Supabase transaction pooler: use port 6543, sslmode=require, and enable this.
DATABASE_POOLER=false
DATABASE_POOL_SIZE=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_CONCURRENCY=4
GEMINI_QUEUE_TIMEOUT_SECONDS=5
# Relative paths resolve from the repository root, independently of the shell cwd.
COURSE_DOCS_PATH=SD_Assessment/SD_Assessment/course_docs
ALLOWED_ORIGINS=http://localhost:5173
CACHE_MAX_ITEMS=500
CACHE_TTL_SECONDS=86400
MAX_QUESTION_LENGTH=2000
REQUEST_MAX_BYTES=16384
REQUESTS_PER_MINUTE=60
MAX_PENDING_REQUESTS=256
REQUEST_LEASE_SECONDS=180
LOG_LEVEL=INFO

# FAQ extraction is always an explicit CLI operation, never a startup/student request.
FAQ_ENABLED=true
FAQ_MODEL_PATH=backend/model_assets/minilm
FAQ_EMBEDDING_THREADS=1
FAQ_INFERENCE_QUEUE=16
FAQ_MEMORY_LIMIT_MB=450
FAQ_REFRESH_SECONDS=30
FAQ_MAX_ENTRIES=1000

# Independent offline batch timeout; student question timeout stays unchanged.
FAQ_EXTRACTION_TIMEOUT_SECONDS=60

# Optional predictive question ranking; typing never invokes Gemini.
SUGGESTION_PREFIX_WEIGHT=0.50
SUGGESTION_LEXICAL_WEIGHT=0.30
SUGGESTION_SEMANTIC_WEIGHT=0.20
SUGGESTION_LEXICAL_MIN_SCORE=0.40
SUGGESTION_SEMANTIC_MIN_SIMILARITY=0.42
SUGGESTION_SEMANTIC_MIN_CHARS=12
SUGGESTION_SEMANTIC_MIN_TOKENS=3
SUGGESTION_CACHE_ITEMS=256
SUGGESTION_CACHE_TTL_SECONDS=15
SUGGESTION_REQUESTS_PER_MINUTE=240
